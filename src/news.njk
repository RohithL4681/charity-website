---
layout: page.njk
title: News & blog
subtitle: Updates and impact stories from our work in the community.
---
<div class="grid grid-2">
  {% for post in collections.posts %}
  <article class="card">
    <div class="card-body">
      <p class="post-meta">{{ post.date | readableDate }}</p>
      <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      <p>{{ post.data.excerpt }}</p>
      <a class="card-link" href="{{ post.url }}">Read more →</a>
    </div>
  </article>
  {% else %}
  <p>No posts published yet. Check back soon.</p>
  {% endfor %}
</div>