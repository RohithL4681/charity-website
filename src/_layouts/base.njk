---
title: BrightHope Foundation
---
<!DOCTYPE html>
<html lang="{{ site.site.language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ pageDescription | default(site.site.description) }}">
  <title>{{ title | default(site.site.name) }}{% if page.url != '/' %} · {{ site.site.name }}{% endif %}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/styles.css">
  <meta name="theme-color" content="{{ site.theme.primary }}">
  <meta property="og:title" content="{{ title | default(site.site.name) }}">
  <meta property="og:description" content="{{ site.site.description }}">
  <meta property="og:type" content="website">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
  <script src="/assets/js/main.js?v=2" defer></script>
</body>
</html>