---
layout: base.njk
---
<header class="page-hero">
  <div class="container">
    <h1>{{ title }}</h1>
    <p class="post-meta">{{ date | readableDate }} · {{ site.site.name }}</p>
  </div>
</header>
<article class="section">
  <div class="container post-content">
    {% if image %}<img class="card-image" src="{{ image }}" alt="{{ title }}" style="border-radius: var(--radius); margin: 0 0 1.5rem;">{% endif %}
    {{ content | safe }}
  </div>
</article>