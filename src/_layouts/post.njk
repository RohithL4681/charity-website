---
layout: base.njk
---
<header class="page-hero">
  <div class="container">
    <h1>{{ title }}</h1>
    <p class="post-meta">{{ date | readableDate }} · {{ site.site.name }}</p>
  </div>
</header>
<article class="section">
  <div class="container post-content">
    {{ content | safe }}
  </div>
</article>