---
layout: base.njk
title: Admin
pageDescription: Content management area for BrightHope Foundation.
---

<header class="page-hero">
  <div class="container">
    <h1>Content manager</h1>
    <p>Add, edit and delete news posts, programs and gallery images. Changes go live automatically.</p>
  </div>
</header>

<section class="section">
  <div class="container admin-wrap">
    <div class="login-card" id="login-card">
      <span style="font-size:2.2rem;">🔐</span>
      <h2 style="margin:0.5rem 0;">Admin sign in</h2>
      <p class="muted" style="font-size:0.9rem;">Enter the admin password to manage the site.</p>
      <input type="password" id="admin-password" placeholder="Admin password" autocomplete="current-password">
      <button class="btn btn-primary" id="admin-login-btn" type="button">Sign in</button>
      <p class="login-error" id="login-error" aria-live="polite"></p>
    </div>

    <div class="admin-panel" id="admin-panel" hidden>
      <div class="banner success" id="admin-welcome" hidden><span>✅</span><span>Signed in. Changes you save are committed to the repository and the site rebuilds automatically.</span></div>

      <div class="admin-tabs" role="tablist">
        <button class="tab-btn active" type="button" role="tab" aria-selected="true" data-tab="news">News posts</button>
        <button class="tab-btn" type="button" role="tab" aria-selected="false" data-tab="programs">Programs</button>
        <button class="tab-btn" type="button" role="tab" aria-selected="false" data-tab="gallery">Gallery</button>
      </div>

      <div class="admin-section" role="tabpanel" id="tab-news">
        <div class="tab-head">
          <h3>📝 News posts</h3>
          <button class="btn btn-primary" type="button" id="post-new-btn">+ New post</button>
        </div>
        <div id="post-list" class="admin-list"></div>

        <div id="post-editor" hidden>
          <hr>
          <h4 id="post-editor-title">New post</h4>
          <div class="form-field">
            <label for="post-title">Title *</label>
            <input type="text" id="post-title" placeholder="e.g. Winter clothing drive a huge success">
          </div>
          <div class="form-field">
            <label for="post-date">Date</label>
            <input type="date" id="post-date">
          </div>
          <div class="form-field">
            <label for="post-excerpt">Short excerpt (shown on news cards)</label>
            <input type="text" id="post-excerpt" placeholder="One or two sentences...">
          </div>
          <div class="form-field">
            <label for="post-image-file">Upload post image * (max 3 MB)</label>
            <input type="file" id="post-image-file" accept="image/*">
            <p class="muted" style="font-size:0.85rem; margin:0.3rem 0 0;">Auto-resized to 1600px JPEG. Filenames are made unique automatically so images never overwrite each other.</p>
            <p class="muted" id="post-image-current" style="font-size:0.85rem; margin:0.3rem 0 0;" hidden></p>
          </div>
          <div class="form-field">
            <label for="post-body">Body (Markdown)</label>
            <textarea id="post-body" rows="10" placeholder="Write your post content in Markdown..."></textarea>
          </div>
          <div class="editor-actions">
            <button class="btn btn-primary" type="button" id="post-save-btn">Save post</button>
            <button class="btn btn-outline" type="button" id="post-cancel-btn">Cancel</button>
            <button class="btn btn-danger" type="button" id="post-delete-btn" hidden>Delete</button>
          </div>
        </div>
      </div>

      <div class="admin-section" role="tabpanel" id="tab-programs" hidden>
        <div class="tab-head">
          <h3>🚀 Programs</h3>
          <button class="btn btn-primary" type="button" id="program-new-btn">+ New program</button>
        </div>
        <div id="program-list" class="admin-list"></div>

        <div id="program-editor" hidden>
          <hr>
          <h4 id="program-editor-title">New program</h4>
          <div class="form-field">
            <label for="program-title">Title *</label>
            <input type="text" id="program-title" placeholder="e.g. Midday meals">
          </div>
          <div class="form-field">
            <label for="program-tag">Tag (e.g. Education, Nutrition, Healthcare)</label>
            <input type="text" id="program-tag" placeholder="e.g. Nutrition">
          </div>
          <div class="form-field">
            <label for="program-order">Order (lower = shown first)</label>
            <input type="number" id="program-order" value="99">
          </div>
          <div class="form-field">
            <label for="program-excerpt">Short description</label>
            <textarea id="program-excerpt" rows="2" placeholder="A few sentences for the program card..."></textarea>
          </div>
          <div class="form-field">
            <label for="program-image-file">Upload program image * (max 3 MB)</label>
            <input type="file" id="program-image-file" accept="image/*">
            <p class="muted" style="font-size:0.85rem; margin:0.3rem 0 0;">Auto-resized to 1600px JPEG. Filenames are made unique automatically so images never overwrite each other.</p>
            <p class="muted" id="program-image-current" style="font-size:0.85rem; margin:0.3rem 0 0;" hidden></p>
          </div>
          <div class="form-field">
            <label for="program-body">Body (Markdown)</label>
            <textarea id="program-body" rows="8" placeholder="Full details in Markdown..."></textarea>
          </div>
          <div class="editor-actions">
            <button class="btn btn-primary" type="button" id="program-save-btn">Save program</button>
            <button class="btn btn-outline" type="button" id="program-cancel-btn">Cancel</button>
            <button class="btn btn-danger" type="button" id="program-delete-btn" hidden>Delete</button>
          </div>
        </div>
      </div>

      <div class="admin-section" role="tabpanel" id="tab-gallery" hidden>
        <div class="tab-head">
          <h3>🖼️ Gallery images</h3>
          <button class="btn btn-primary" type="button" id="gallery-upload-btn">+ Upload image</button>
        </div>
        <p class="muted" style="font-size:0.88rem;">Uploaded photos are automatically resized and compressed (max 1600px, JPEG).</p>
        <div id="gallery-upload" hidden>
          <div class="form-field">
            <label for="gallery-file">Choose a photo</label>
            <input type="file" id="gallery-file" accept="image/*">
          </div>
          <div class="form-field">
            <label for="gallery-caption">Caption (shown under the photo)</label>
            <input type="text" id="gallery-caption" placeholder="e.g. Meal kit distribution at Green Park colony">
          </div>
          <div class="editor-actions">
            <button class="btn btn-primary" type="button" id="gallery-upload-save-btn">Upload</button>
            <button class="btn btn-outline" type="button" id="gallery-upload-cancel-btn">Cancel</button>
          </div>
        </div>
        <div id="gallery-grid" class="admin-gallery" hidden></div>
        <p class="muted" id="gallery-empty" hidden>No images yet. Upload your first photo above.</p>
      </div>

      <p class="muted admin-foot">Changes are committed to your GitHub repository. The site rebuilds automatically within a minute.</p>
    </div>
  </div>
</section>

<div id="admin-status" class="admin-status" role="status" aria-live="polite" hidden></div>

<script src="/assets/js/admin.js" defer></script>