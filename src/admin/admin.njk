---
layout: base.njk
title: Admin
pageDescription: Content management area for BrightHope Foundation.
---

<header class="page-hero">
  <div class="container">
    <h1>Content manager</h1>
    <p>Sign in to generate posts and manage your website content.</p>
  </div>
</header>

<section class="section">
  <div class="container admin-wrap">
    <div class="login-card" id="login-card">
      <span style="font-size:2.2rem;">🔐</span>
      <h2 style="margin:0.5rem 0;">Admin sign in</h2>
      <p class="muted" style="font-size:0.9rem;">Enter the admin password to continue.</p>
      <input type="password" id="admin-password" placeholder="Admin password" autocomplete="current-password">
      <button class="btn btn-primary" id="admin-login-btn" type="button">Sign in</button>
      <p class="login-error" id="login-error" aria-live="polite"></p>
    </div>

    <div class="admin-panel" id="admin-panel" hidden>
      <div class="banner success"><span>✅</span><span>You are signed in. Use the tools below, then rebuild and redeploy your site to publish changes.</span></div>

      <div class="admin-section">
        <h3>📝 Add a news post</h3>
        <p class="muted" style="font-size:0.9rem;">Fill in the fields, click <strong>Generate</strong>, then copy the preview below into a new file in <code>src/posts/</code>. Name it like <code>my-post-title.md</code> (lowercase, dashes). Then run <code>npm run deploy</code>.</p>
        <div class="form-field">
          <label for="post-title">Post title</label>
          <input type="text" id="post-title" placeholder="e.g. Winter clothing drive a huge success">
        </div>
        <div class="form-field">
          <label for="post-excerpt">Short excerpt (shown on news cards)</label>
          <input type="text" id="post-excerpt" placeholder="One or two sentences...">
        </div>
        <div class="form-field">
          <label for="post-body">Body — write in Markdown (start each paragraph with a blank line)</label>
          <textarea id="post-body" rows="8" placeholder="Write your post content here in Markdown..."></textarea>
        </div>
        <button class="btn btn-primary" id="post-generate-btn" type="button">Generate post Markdown</button>
        <button class="btn btn-outline" id="post-copy-btn" type="button">Copy to clipboard</button>
        <pre id="post-output" style="margin-top:1rem;" hidden></pre>
      </div>

      <div class="admin-section">
        <h3>🚀 Add a program</h3>
        <p class="muted" style="font-size:0.9rem;">Programs live in <code>src/_programs/</code>. Generate below, save as <code>program-name.md</code>, then rebuild.</p>
        <div class="form-field">
          <label for="prog-title">Program title</label>
          <input type="text" id="prog-title" placeholder="e.g. Midday meals">
        </div>
        <div class="form-field">
          <label for="prog-tag">Short tag</label>
          <input type="text" id="prog-tag" placeholder="e.g. Nutrition">
        </div>
        <div class="form-field">
          <label for="prog-excerpt">Short description</label>
          <textarea id="prog-excerpt" rows="3" placeholder="A few sentences for the program card..."></textarea>
        </div>
        <div class="form-field">
          <label for="prog-balance">Body — what this program does</label>
          <textarea id="prog-body" rows="6" placeholder="Full details in Markdown..."></textarea>
        </div>
        <button class="btn btn-primary" id="prog-generate-btn" type="button">Generate program Markdown</button>
        <button class="btn btn-outline" id="prog-copy-btn" type="button">Copy to clipboard</button>
        <pre id="prog-output" style="margin-top:1rem;" hidden></pre>
      </div>

      <div class="admin-section">
        <h3>🖼️ Images</h3>
        <ul style="font-size:0.95rem;">
          <li><strong>Gallery:</strong> drop any image into <code>src/images/gallery/</code> (jpg/png/webp). It appears on the gallery page automatically. Add a caption in <code>src/_data/gallery.js</code>.</li>
          <li><strong>Hero:</strong> replace <code>src/images/hero.jpg</code> with your own photo (keep the same name).</li>
          <li><strong>Home / About:</strong> replace <code>src/images/community.jpg</code>.</li>
          <li><strong>Programs:</strong> set <code>image:</code> in <code>src/_programs/*.md</code> to any path under <code>/images/</code>.</li>
        </ul>
      </div>

      <div class="admin-section">
        <h3>🎨 Site settings, donations & contact</h3>
        <p style="font-size:0.95rem;">Everything (site name, navigation, donation links, contact details, impact stats) is editable in one place: <code>src/_data/site.json</code>. See the project <code>README.md</code> for how to change your Razorpay payment links and admin password.</p>
      </div>
    </div>
  </div>
</section>

<script id="admin-config" type="application/json">{{ { passwordHash: site.admin.passwordHash } | dump | safe }}</script>
<script src="/assets/js/admin.js" defer></script>